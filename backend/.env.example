# Server Configuration
PORT=5000
NODE_ENV=development

# Database - MongoDB Atlas
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/fitsage?retryWrites=true&w=majority&appName=FitSage

# Example:
# MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.mongodb.net/fitsage?retryWrites=true&w=majority&appName=FitSage

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# AI API Configuration (Choose ONE)
# -----------------------------

# Option 1: Google Gemini (FREE - Recommended!)
# Get your free API key: https://aistudio.google.com/app/apikey
# - 15 requests per minute
# - 1500 requests per day
# - No credit card required
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI (Paid - requires credits)
# Get your API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Option 3: Anthropic Claude (Paid - requires credits)
# Get your API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Choose AI Provider: 'gemini', 'openai', or 'anthropic' (lowercase)
AI_PROVIDER=gemini

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
